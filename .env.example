# Optional OpenAI-compatible chat completion endpoint.
# Without these values, Banwutong uses its deterministic rule extractor.
# 例：DeepSeek -> https://api.deepseek.com + deepseek-flash
BANWUTONG_LLM_BASE_URL=
BANWUTONG_LLM_MODEL=
BANWUTONG_LLM_API_KEY=

# Optional local storage paths.
BANWUTONG_DATABASE_PATH=
BANWUTONG_UPLOAD_DIR=

# QQ 机器人（个人主体即可创建）。AppSecret 只放本地，不要提交、不要截图。
QQBOT_APPID=
QQBOT_SECRET=
# 机器人把消息转发到哪个后端地址
BANWUTONG_API=http://127.0.0.1:8765
# 文字通知怎么回：created=只在新建事项时回（默认），always=每次都回，never=只处理不回复。
# 图片/文件的解析回执不受这个开关影响，总会回。
QQBOT_REPLY_TEXT=created

# 公网访问鉴权。两项都填才会启用登录页；留空则等同于不鉴权（仅建议本机使用）。
# 127.0.0.1 直连（机器人转发）始终放行，不需要登录。
BANWUTONG_AUTH_USER=
BANWUTONG_AUTH_PASSWORD=
# 会话 Cookie 的签名密钥，留空则用账号密码派生；改了会让所有已登录设备失效。
BANWUTONG_AUTH_SECRET=

# Web Push（截止提醒）。用 `python -m py_vapid` 或 pywebpush 生成一对密钥后填入。
# 换密钥会让所有已订阅设备失效，需要重新「开启提醒」。
BANWUTONG_VAPID_PUBLIC_KEY=
BANWUTONG_VAPID_PRIVATE_KEY=
BANWUTONG_VAPID_SUBJECT=mailto:you@example.com

# 设为 1 可关闭后台提醒循环（排查问题时用）。
BANWUTONG_REMINDERS_DISABLED=

# 可选的外部提醒渠道。留空即不启用；和 Web Push 互不影响，可同时开。
# Webhook 会收到 JSON POST：{"type":"banwutong.reminder","title":...,"text":...,"activity":{...}}
BANWUTONG_REMINDER_WEBHOOK_URL=
BANWUTONG_REMINDER_WEBHOOK_TOKEN=
# 邮件渠道：SMTP_HOST、SMTP_FROM、SMTP_TO 三项齐全才会启用。
BANWUTONG_SMTP_HOST=
BANWUTONG_SMTP_PORT=587
BANWUTONG_SMTP_USER=
BANWUTONG_SMTP_PASSWORD=
BANWUTONG_SMTP_FROM=
BANWUTONG_SMTP_TO=
# 465 端口一般要开；587 端口走 STARTTLS，保持 false。
BANWUTONG_SMTP_USE_SSL=false
